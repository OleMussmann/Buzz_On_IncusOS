# Copy to .env and replace every CHANGE_ME value before the first `up`.
# Never commit this file's filled-in twin — .env is gitignored.
#
# Generate the random secrets with:
#   openssl rand -hex 32
# Hex-only output sidesteps .env parsing pitfalls: `$` triggers variable
# interpolation and `#` starts a comment.
#
# Generate the Nostr keypairs with buzz-admin — see "Identities and keys"
# in README.md. RELAY_OWNER_PUBKEY must be 64-char hex, NOT an npub.

# ---------------------------------------------------------------------------
# Endpoint. RELAY_URL must match byte-for-byte what clients connect with,
# scheme included — a trailing slash or http-vs-ws mismatch breaks auth.
# For a Tailscale-only deployment this is the host's tailnet IP.
# Swap ws:// for wss:// only once something actually terminates TLS.
# ---------------------------------------------------------------------------
RELAY_URL=ws://CHANGE_ME_TAILSCALE_IP:3000
BUZZ_MEDIA_BASE_URL=http://CHANGE_ME_TAILSCALE_IP:3000/media
BUZZ_MEDIA_SERVER_DOMAIN=CHANGE_ME_TAILSCALE_IP:3000
BUZZ_CORS_ORIGINS=http://CHANGE_ME_TAILSCALE_IP:3000

# ---------------------------------------------------------------------------
# Identity — from `buzz-admin generate-key`, TWO separate runs.
# Placeholders differ because these take different halves of different runs.
# Both are permanent: the relay key is the relay's own signing identity, and
# the owner pubkey CANNOT be removed from the member list later. Back both up
# before the first start.
# ---------------------------------------------------------------------------
# Run 1, "Public key:" line. The secret half of run 1 is YOURS — password
# manager or Nostr client, never this file.
RELAY_OWNER_PUBKEY=CHANGE_ME_GENERATE_KEY_RUN1_PUBLIC
# Run 2, "Secret key:" line. The public half of run 2 is not used anywhere.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_GENERATE_KEY_RUN2_SECRET

# ---------------------------------------------------------------------------
# Stable secrets — every one of these is `openssl rand -hex 32`, which is why
# they share a placeholder. Generate once; changing them later is a migration,
# not a config edit.
#
# !! RUN THE COMMAND ONCE PER LINE. The placeholder is identical, the values
# !! must not be. Five lines below, five separate runs, five distinct values.
# ---------------------------------------------------------------------------
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=CHANGE_ME_OPENSSL_RAND_HEX_32
REDIS_PASSWORD=CHANGE_ME_OPENSSL_RAND_HEX_32
# NOT credentials for an external S3 account. MinIO runs inside this stack and
# is configured WITH these two values (they become MINIO_ROOT_USER and
# MINIO_ROOT_PASSWORD) — you invent them, MinIO adopts them on first boot.
# The bucket is created automatically by the minio-init one-shot; there is
# nothing to set up by hand.
BUZZ_S3_ACCESS_KEY=CHANGE_ME_OPENSSL_RAND_HEX_32
BUZZ_S3_SECRET_KEY=CHANGE_ME_OPENSSL_RAND_HEX_32
BUZZ_S3_BUCKET=buzz-media

# ---------------------------------------------------------------------------
# Behaviour. Defaults in compose.yaml already match these; override here only
# if you mean to.
# ---------------------------------------------------------------------------
# Closed relay: only registered members may connect.
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
# Runs embedded SQLx migrations on boot. Required to bootstrap a fresh DB.
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info
