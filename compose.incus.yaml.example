# Copy to compose.incus.yaml and replace IncusOS_IP_ADDRESS with the host's
# Tailscale IP. Long-form ports with x-incus-compose.nat: true opt into
# kernel NAT proxy mode (needs Incus 7.2+).
#
# These ports are declared ONLY here — compose.yaml must not also declare
# them, since compose merges port lists and a duplicate proxy-<port> device
# would collide on device name.
#
# Binding to the Tailscale address specifically, rather than 0.0.0.0, is what
# keeps the relay off the public internet and off the LAN. Don't drop the
# host_ip prefix.
services:
  relay:
    ports:
      # 3000 — the relay itself: WebSocket (Nostr), REST API, web UI.
      # This is the one agents and the Buzz desktop/mobile apps connect to,
      # and the one RELAY_URL must name.
      - published: "3000"
        target: "3000"
        host_ip: "IncusOS_IP_ADDRESS"
        x-incus-compose:
          nat: true
      # 8080 — health probes only: /_liveness and /_readiness. The relay's
      # own healthcheck reaches this on 127.0.0.1 inside the container, so
      # publishing it buys nothing except external uptime monitoring.
      # Safe to delete this entry if you don't want the extra surface.
      - published: "8080"
        target: "8080"
        host_ip: "IncusOS_IP_ADDRESS"
        x-incus-compose:
          nat: true
      # 9102 — Prometheus metrics. Published for the "monitor system metrics,
      # replace dashboard" task in the vault's ai-stack/tasks.md.
      - published: "9102"
        target: "9102"
        host_ip: "IncusOS_IP_ADDRESS"
        x-incus-compose:
          nat: true
